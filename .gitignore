# 通用忽略
node_modules/
dist/
build/
.env
.env.*
!.env.example
*.log
*.log.err
*.apk
*.aab
.DS_Store
Thumbs.db

# 本机构建 / 验证产物（真机截图 / 临时导出 / APK 归档；*.apk 已在上方忽略）
outputs/

# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins*
app/.idea/
app/ios/Pods/
app/ios/.symlinks/
app/android/.gradle/
app/android/local.properties
app/*.iml
app/.pub-cache/
app/.metadata

# 上传素材（用户录音/实景视频不入库，走对象存储）
uploads/
*.wav
*.mp4
!docs/samples/*.mp4

# FFmpeg 静态二进制（不入库，见 server/bin/README 或 FFMPEG_PATH 说明）
server/bin/

# 密钥
*.pem
*.p8
serviceAccount*.json

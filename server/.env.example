# ===== 服务基础 =====
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ===== PostgreSQL（Drizzle ORM）=====
# 示例连接串，请改成你本机的账号密码；数据库名建议 starvoice
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/starvoice

# ===== DeepSeek：话术生成 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 话术生成模型，默认 deepseek-chat（真实调用 DeepSeek，必须配置 API Key）
DEEPSEEK_MODEL=deepseek-chat

# ===== 阿里云 CosyVoice：声音克隆 + 口播 TTS =====
# - 本地无 key / 纯演示：保持 MOCK_COSYVOICE=true，克隆走 mock、合成回退占位音轨；
# - 真实口播合成（G1）：填 COSYVOICE_API_KEY 并把 MOCK_COSYVOICE 设为 false；
#   声音克隆仍为 mock（真实克隆在后续任务接入），演示需用已存在的真实音色 voice_id。
# base_url 留空时使用服务商默认地址 https://dashscope.aliyuncs.com
COSYVOICE_API_KEY=
COSYVOICE_BASE_URL=
COSYVOICE_MODEL=cosyvoice-v2
# 关闭 mock 后，真实口播 TTS 会真实调用 DashScope（按量计费），测试场景请保持开启
MOCK_COSYVOICE=true

# ===== 抖音开放平台：OAuth + 团购券 + 推流 =====
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=http://127.0.0.1:3000/auth/douyin/callback
# 即使配置了真实 client key 也强制走 mock（真实 key 下仍可本地联调绑定链路）
MOCK_DOUYIN=false

# ===== 微信支付：订阅支付 =====
WXPAY_APPID=
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WXPAY_CERT_SERIAL_NO=
WXPAY_NOTIFY_URL=https://your-domain.example.com/api/pay/notify

# ===== JWT：登录态签名密钥（必填）=====
# 本地开发用足够长的随机串即可；生产必须用强随机值，例如 openssl rand -hex 32
JWT_SECRET=

# ===== 后台管理（内部运营工具，admin_users 只允许预置账号登录）=====
# 初始管理员账号（npm run admin:seed 使用；不留默认口令，口令至少 8 位）
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
# 后台命名空间 JWT 独立密钥（可选）：不填时自动用 JWT_SECRET 派生独立子串；
# 生产建议显式配置强随机值，保证后台与商家端 token 完全隔离
ADMIN_JWT_SECRET=

# ===== G5 现场口播出口（临时：Windows 本机语音，换商用/克隆音色时改配置）=====
# 模式 B 现场互动：AI 回复是否出声；默认 true（仅 Windows 生效）
LIVE_SPEAKER_ENABLED=true
# 出声通道：pc = 本机播放（默认，开发自测 / 音频转接线接开播手机）；phone = 交远程出声队列（助播机轮询拉取，需二期客户端配套）
LIVE_SPEAKER_OUTPUT=pc
# TTS 通道：local = Windows 本机 SAPI（默认，保出声）；volc = 火山豆包语音（需账号已开通模型服务后再切）
LIVE_TTS_PROVIDER=local
# Windows 本机音色名（可选）：不填用默认女声 Microsoft Huihui Desktop；可选 Microsoft Kangkang / Microsoft Yaoyao 等
LOCAL_TTS_VOICE=Microsoft Huihui Desktop

# ===== 火山引擎（豆包语音）TTS：G5 商用音色（CosyVoice 降为备选）=====
# 合成器已落地（src/services/volcTTS.ts）；liveSpeaker 在 LIVE_TTS_PROVIDER=volc 且本 key 已填时切换火山音色。
# 火山账号需先在控制台开通「豆包语音合成大模型 2.0」服务，否则返回 45000030（resource not granted）。
# API Key 获取：https://console.volcengine.com/speech/new/setting/apikeys
VOLC_TTS_API_KEY=
# 服务基址：一般保持官方默认即可
VOLC_TTS_BASE_URL=https://openspeech.bytedance.com
# 合成资源 ID：豆包语音合成大模型 2.0
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# 默认音色（发音人 ID）：火山官方示例通用音色，正式用前按音色列表替换
# 音色列表：https://www.volcengine.com/docs/6561/1257544
VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts
# 采样率：官方可选 8000/16000/22050/24000/32000/44100/48000，默认 24000
VOLC_TTS_SAMPLE_RATE=24000
# 语速：范围 [-50, 100]，0 为正常语速
VOLC_TTS_SPEECH_RATE=0

# ===== 抖音 wss 采集签名服务（D2.3/D2.5 解锁后启用）=====
# 作用：把抖音 web 房间号换成可直连的抖音 im wss 地址（第三方签名，Key 由部署方自备，代码不内置）
# 验收/排查：npm run sign:smoke -- <抖音web房间号>
DOUYIN_SIGN_ENDPOINT_URL=https://api.aiobs.cn/Douyin/Douyin/SignWss
DOUYIN_SIGN_API_KEY=
# 可选：签名时携带的账号身份（UserUniqueId，通常填抖音用户唯一 id；留空由服务端决定）
DOUYIN_SIGN_USER_UNIQUE_ID=
# ===== TTS 分句缓存（T3）：命中旁路真实合成，控制每小时新合成量 =====
# false 时旁路缓存（灰度对比命中率/成本）；缓存根目录默认相对 server 运行目录 data/tts-cache
TTS_CACHE_ENABLED=true
TTS_CACHE_DIR=data/tts-cache
